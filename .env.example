/# Project Atlas local development environment
# Copy or override these values for your machine. Do not commit real secrets.

# -----------------------------------------------------------------------------
# Project
# -----------------------------------------------------------------------------
PROJECT_NAME=atlas
ENVIRONMENT=local
COMPOSE_PROJECT_NAME=atlas
TZ=UTC

# -----------------------------------------------------------------------------
# Network and ports
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
SCHEMA_REGISTRY_URL=http://schema-registry:8081
KAFKA_CONNECT_URL=http://kafka-connect:8083
AIRFLOW_URL=http://localhost:8080
GRAFANA_URL=http://localhost:3000
PROMETHEUS_URL=http://localhost:9090
OPENMETADATA_URL=http://localhost:8585
MINIO_ENDPOINT=http://minio:9000
MINIO_CONSOLE_URL=http://localhost:9001
AWS_ENDPOINT_URL=http://minio:9000

# -----------------------------------------------------------------------------
# PostgreSQL source database
# -----------------------------------------------------------------------------
POSTGRES_DB=atlas_commerce
POSTGRES_USER=atlas_app
POSTGRES_PASSWORD=change_me_local
POSTGRES_REPLICATION_USER=atlas_repl
POSTGRES_REPLICATION_PASSWORD=change_me_local_repl
POSTGRES_SCHEMA=public
POSTGRES_PUBLICATION=atlas_publication
POSTGRES_REPLICATION_SLOT=atlas_debezium_slot

# -----------------------------------------------------------------------------
# Kafka and Debezium
# -----------------------------------------------------------------------------
KAFKA_CLUSTER_ID=atlas-local-cluster
KAFKA_DEFAULT_PARTITIONS=6
KAFKA_DEFAULT_REPLICATION_FACTOR=1
KAFKA_TOPIC_RETENTION_MS=604800000
KAFKA_CONNECT_GROUP_ID=atlas-connect
DEBEZIUM_CONNECTOR_NAME=atlas-postgres-cdc
DEBEZIUM_DATABASE_SERVER_NAME=atlas_postgres
DEBEZIUM_SNAPSHOT_MODE=initial

# -----------------------------------------------------------------------------
# Schema governance
# -----------------------------------------------------------------------------
SCHEMA_COMPATIBILITY=BACKWARD
SCHEMA_SUBJECT_NAME_STRATEGY=TopicRecordNameStrategy

# -----------------------------------------------------------------------------
# Spark and Delta Lake
# -----------------------------------------------------------------------------
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_APP_NAME=atlas-streaming
SPARK_CHECKPOINT_ROOT=/opt/atlas/checkpoints
DELTA_LAKE_ROOT=/opt/atlas/data
BRONZE_PATH=/opt/atlas/data/bronze
SILVER_PATH=/opt/atlas/data/silver
GOLD_PATH=/opt/atlas/data/gold
QUARANTINE_PATH=/opt/atlas/data/quarantine
STREAM_TRIGGER_SECONDS=30
STREAM_WATERMARK_DELAY=10 minutes

# -----------------------------------------------------------------------------
# Local S3 object storage
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=atlas_minio
MINIO_ROOT_PASSWORD=change_me_minio
AWS_ACCESS_KEY_ID=atlas_minio
AWS_SECRET_ACCESS_KEY=change_me_minio
AWS_REGION=us-east-1
AWS_S3_ALLOW_UNSAFE_RENAME=true
S3_BUCKET_BRONZE=atlas-bronze
S3_BUCKET_SILVER=atlas-silver
S3_BUCKET_GOLD=atlas-gold
S3_BUCKET_QUARANTINE=atlas-quarantine
S3_BUCKET_CHECKPOINTS=atlas-checkpoints
S3_BUCKET_BACKUPS=atlas-backups
S3_BUCKET_SYNTHETIC=atlas-synthetic

# -----------------------------------------------------------------------------
# Airflow
# -----------------------------------------------------------------------------
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://atlas_app:change_me_local@postgres:5432/airflow
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change_me_airflow
AIRFLOW_ADMIN_EMAIL=admin@example.com

# -----------------------------------------------------------------------------
# Data quality
# -----------------------------------------------------------------------------
GREAT_EXPECTATIONS_HOME=/opt/atlas/quality
QUALITY_FAIL_ON_CRITICAL=true
QUALITY_QUARANTINE_ENABLED=true

# -----------------------------------------------------------------------------
# Observability and alerting
# -----------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana
PROMETHEUS_SCRAPE_INTERVAL=15s
ALERTMANAGER_WEBHOOK_URL=http://localhost:9093
SLO_FRESHNESS_P95_SECONDS=60
KAFKA_LAG_ALERT_SECONDS=300
GOLD_TABLE_STALE_SECONDS=300
DISK_PRESSURE_THRESHOLD_PERCENT=85

# -----------------------------------------------------------------------------
# Metadata and catalog
# -----------------------------------------------------------------------------
OPENMETADATA_ADMIN_USER=admin
OPENMETADATA_ADMIN_PASSWORD=change_me_openmetadata
DATA_PRODUCT_OWNER=data-platform-engineering
DATA_CLASSIFICATION=synthetic-public

# -----------------------------------------------------------------------------
# Workload generation
# -----------------------------------------------------------------------------
WORKLOAD_SEED=42
WORKLOAD_CUSTOMERS=10000
WORKLOAD_PRODUCTS=1000
WORKLOAD_EVENTS_PER_SECOND=100
WORKLOAD_BURST_MULTIPLIER=5
WORKLOAD_LATE_EVENT_PERCENT=2
WORKLOAD_DUPLICATE_EVENT_PERCENT=1
WORKLOAD_DELETE_PERCENT=1

# -----------------------------------------------------------------------------
# Testing and recovery
# -----------------------------------------------------------------------------
TEST_RECORD_TARGET=100000000
RECOVERY_TARGET_MINUTES=15
BACKUP_ROOT=/opt/atlas/backups
REPLAY_DEFAULT_START_OFFSET=earliest

# -----------------------------------------------------------------------------
# Optional local analytics
# -----------------------------------------------------------------------------
DUCKDB_DATABASE=/opt/atlas/data/atlas.duckdb
TRINO_HOST=trino
TRINO_PORT=8080
